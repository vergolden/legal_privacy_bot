# Скопируй этот файл в .env (без .example) в родительскую папку по отношению к
# scripts/ и заполни реальными значениями. .env никогда не попадает в git.
# Скрипты по умолчанию ищут .env на уровень выше себя (../.env) — так исторически
# сложилось, потому что бот живёт как подпапка внутри рабочей директории Legal Privacy.
# Путь можно переопределить флагом --env-file там, где он есть (publish_telegram.py,
# generate_image.py, send_telegram.py).

# ProxyAPI.ru — генерация картинок (модели семейства GPT Image)
PROXYAPI_API_KEY=

# VK — публикация на стену сообщества
# Community Token — посты БЕЗ картинки. User Token — обязателен для постов С картинкой
# (Community Token не может загружать фото, ограничение VK API, error 27).
VK_COMMUNITY_TOKEN=
VK_USER_TOKEN=

# Числовой ID группы ВК (без минуса)
VK_GROUP_ID=

# Telegram-бот для доставки черновиков на утверждение и публикации в канал (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Chat ID получателей черновиков — числовые ID личных чатов с ботом
TELEGRAM_CHAT_ID_ANDREW=
TELEGRAM_CHAT_ID_WIFE=

# Публичный канал, куда публикуются одобренные посты (формат @username)
TELEGRAM_CHANNEL_ID=
